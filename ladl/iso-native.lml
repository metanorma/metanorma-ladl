  context = ref:(AnnexContext)
  parent = ref:(AnnexLabeller)
  type = "figure"
  template = ref:(AnnexFigureLabelTemplate)
  global_template = ref:(AnnexFigureGlobalLabelTemplate)
  definition = "Labeller for figures in annexes"
}

LabelTemplate "SubfigureLabelTemplate" {
  pattern = "Figure %pn %n)"
  definition = "Template for local subfigure references"
}

LabelTemplate "SubfigureGlobalLabelTemplate" {
  pattern = "Figure %pn %n)"
  definition = "Template for global subfigure references"
}

Labeller "SubfigureLabeller" {
  id = "subfigure_labeller"
  sequence = ref:(AlphaLowerNumericSequence)
  context = ref:(DocumentContext)
  parent = ref:(FigureLabeller)
  type = "subfigure"
  template = ref:(SubfigureLabelTemplate)
  global_template = ref:(SubfigureGlobalLabelTemplate)
  definition = "Labeller for subfigures in the document"
