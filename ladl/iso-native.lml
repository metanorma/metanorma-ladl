  pattern = "Table %pn.%n"
  definition = "Template for local table references in annexes"
}

LabelTemplate "AnnexTableGlobalLabelTemplate" {
  pattern = "Table %pn.%n"
  definition = "Template for global table references in annexes"
}

Labeller "AnnexTableLabeller" {
  id = "annex_table_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(AnnexContext)
  parent = ref:(AnnexLabeller)
  type = "table"
  template = ref:(AnnexTableLabelTemplate)
  global_template = ref:(AnnexTableGlobalLabelTemplate)
  definition = "Labeller for tables in annexes"
}

LabelTemplate "NoteSingleLabelTemplate" {
  pattern = "NOTE"
  definition = "Template for single note references"
}

LabelTemplate "NoteMultipleLabelTemplate" {
  pattern = "NOTE %n"
  definition = "Template for multiple note references"
  condition = { type = "element_count_gt" threshold = 1 }
}

LabelTemplate "NoteSingleGlobalLabelTemplate" {
  pattern = "%parent, NOTE"
  definition = "Template for global single note references"
}

LabelTemplate "NoteMultipleGlobalLabelTemplate" {
  pattern = "%parent, NOTE %n"
  definition = "Template for global multiple note references"
  condition = { type = "element_count_gt" threshold = 1 }
}

Labeller "NoteLabeller" {
  id = "note_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(ClauseContext)
  type = "note"
  template = [ref:(NoteSingleLabelTemplate), ref:(NoteMultipleLabelTemplate)]
  global_template = [ref:(NoteSingleGlobalLabelTemplate), ref:(NoteMultipleGlobalLabelTemplate)]
  definition = "Labeller for notes in clauses with conditional templates based on note count"
}

LabelTemplate "ExampleSingleLabelTemplate" {
  pattern = "EXAMPLE"
  definition = "Template for single example references"
}

LabelTemplate "ExampleMultipleLabelTemplate" {
  pattern = "EXAMPLE %n"
  definition = "Template for multiple example references"
  condition = { type = "element_count_gt" threshold = 1 }
}

LabelTemplate "ExampleSingleGlobalLabelTemplate" {
  pattern = "%parent, EXAMPLE"
  definition = "Template for global single example references"
}

LabelTemplate "ExampleMultipleGlobalLabelTemplate" {
  pattern = "%parent, EXAMPLE %n"
  definition = "Template for global multiple example references"
  condition = { type = "element_count_gt" threshold = 1 }
}

Labeller "ExampleLabeller" {
  id = "example_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(ClauseContext)
  type = "example"
  template = [ref:(ExampleSingleLabelTemplate), ref:(ExampleMultipleLabelTemplate)]
  global_template = [ref:(ExampleSingleGlobalLabelTemplate), ref:(ExampleMultipleGlobalLabelTemplate)]
  definition = "Labeller for examples in clauses with conditional templates based on example count"
}

LabelTemplate "FormulaLabelTemplate" {
  pattern = "(%n)"
  definition = "Template for local formula references in the main document"
}

LabelTemplate "FormulaGlobalLabelTemplate" {
  pattern = "Formula (%n)"
  definition = "Template for global formula references in the main document"
}

Labeller "FormulaLabeller" {
  id = "formula_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(DocumentContext)
