LabelStyle "ISOIECNativeLabelStyle" {
  name = "ISO/IEC Native Presentation Inputs"
  definition = "Operative native list specialization; original worked-example declarations remain separately available."
  labellers = ["id:clause_labeller", "id:subclause_labeller", "id:annex_labeller", "id:annex_clause_labeller", "id:figure_labeller", "id:annex_figure_labeller", "id:subfigure_labeller", "id:table_labeller", "id:annex_table_labeller", "id:note_labeller", "id:example_labeller", "id:formula_labeller", "id:annex_formula_labeller", "id:list_labeller", "id:annex_list_labeller", "id:unordered_list_item_labeller", "id:ordered_list_item_level1_labeller", "id:ordered_list_item_level2_labeller", "id:ordered_list_item_level3_labeller", "id:ordered_list_item_level4_labeller", "id:native_ordered_list_style_arabic", "id:native_ordered_list_style_alphabet", "id:native_ordered_list_style_alphabet_upper", "id:native_ordered_list_style_roman", "id:native_ordered_list_style_roman_upper", "id:native_ordered_list_level1", "id:native_ordered_list_level2", "id:native_ordered_list_level3", "id:native_ordered_list_level4", "id:native_ordered_list_level5", "id:native_ordered_list_level6", "id:native_ordered_list_level7", "id:native_ordered_list_level8", "id:native_ordered_list_level9", "id:native_ordered_list_level10", "id:native_ordered_list_deep"]
  sequences = [ref:(DecimalNumericSequence), ref:(AlphaLowerNumericSequence), ref:(AlphaUpperNumericSequence), ref:(RomanLowerNumericSequence), ref:(RomanUpperNumericSequence), ref:(NativeLowerLetterSequence), ref:(NativeUpperLetterSequence)]
  templates = [ref:(ClauseLabelTemplate), ref:(ClauseGlobalLabelTemplate), ref:(SubclauseLabelTemplate), ref:(SubclauseGlobalLabelTemplate), ref:(AnnexLabelTemplate), ref:(AnnexGlobalLabelTemplate), ref:(AnnexClauseLabelTemplate), ref:(AnnexClauseGlobalLabelTemplate), ref:(FigureLabelTemplate), ref:(FigureGlobalLabelTemplate), ref:(AnnexFigureLabelTemplate), ref:(AnnexFigureGlobalLabelTemplate), ref:(SubfigureLabelTemplate), ref:(SubfigureGlobalLabelTemplate), ref:(TableLabelTemplate), ref:(TableGlobalLabelTemplate), ref:(AnnexTableLabelTemplate), ref:(AnnexTableGlobalLabelTemplate), ref:(NoteSingleLabelTemplate), ref:(NoteMultipleLabelTemplate), ref:(NoteSingleGlobalLabelTemplate), ref:(NoteMultipleGlobalLabelTemplate), ref:(ExampleSingleLabelTemplate), ref:(ExampleMultipleLabelTemplate), ref:(ExampleSingleGlobalLabelTemplate), ref:(ExampleMultipleGlobalLabelTemplate), ref:(FormulaLabelTemplate), ref:(FormulaGlobalLabelTemplate), ref:(AnnexFormulaLabelTemplate), ref:(AnnexFormulaGlobalLabelTemplate), ref:(ListLabelTemplate), ref:(ListGlobalLabelTemplate), ref:(AnnexListLabelTemplate), ref:(AnnexListGlobalLabelTemplate), ref:(UnorderedListItemLabelTemplate), ref:(OrderedListItemLevel1LabelTemplate), ref:(OrderedListItemLevel2LabelTemplate), ref:(OrderedListItemLevel3LabelTemplate), ref:(OrderedListItemLevel4LabelTemplate), ref:(NativeUpperListTemplate), ref:(NativeSingleListTemplate), ref:(NativeMultipleListTemplate)]
  contexts = [ref:(DocumentContext), ref:(ClauseContext), ref:(SubclauseContext), ref:(AnnexContext), ref:(AnnexClauseContext), ref:(ListContext)]
}

LabelContext "DocumentContext" {
  name = "document"
  definition = "Top-level document context for ISO/IEC documents"
}

LabelContext "ClauseContext" {
  name = "clause"
  parent = ref:(DocumentContext)
  definition = "Context for clauses within the main document"
}

LabelContext "SubclauseContext" {
  name = "subclause"
  parent = ref:(ClauseContext)
  definition = "Context for subclauses within clauses"
}

LabelTemplate "ClauseLabelTemplate" {
  pattern = "Clause %n"
  definition = "Template for local clause references"
}

LabelTemplate "ClauseGlobalLabelTemplate" {
  pattern = "Clause %n"
  definition = "Template for global clause references"
}

Labeller "ClauseLabeller" {
  id = "clause_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(DocumentContext)
  type = "clause"
  template = ref:(ClauseLabelTemplate)
  global_template = ref:(ClauseGlobalLabelTemplate)
  definition = "Labeller for clauses in the main document"
}

LabelTemplate "SubclauseLabelTemplate" {
  pattern = "%pn.%n"
  definition = "Template for local subclause references"
}

LabelTemplate "SubclauseGlobalLabelTemplate" {
  pattern = "%pn.%n"
  definition = "Template for global subclause references"
}

Labeller "SubclauseLabeller" {
  id = "subclause_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(ClauseContext)
  parent = ref:(ClauseLabeller)
  type = "subclause"
  template = ref:(SubclauseLabelTemplate)
  global_template = ref:(SubclauseGlobalLabelTemplate)
  definition = "Labeller for subclauses within clauses"
}

LabelContext "AnnexContext" {
  name = "annex"
  parent = ref:(DocumentContext)
  definition = "Context for annexes within the document"
}

LabelContext "AnnexClauseContext" {
  name = "annex_clause"
  parent = ref:(AnnexContext)
  definition = "Context for clauses within annexes"
}

LabelTemplate "AnnexLabelTemplate" {
  pattern = "Annex %n"
  definition = "Template for local annex references"
}

LabelTemplate "AnnexGlobalLabelTemplate" {
  pattern = "Annex %n"
  definition = "Template for global annex references"
}

Labeller "AnnexLabeller" {
  id = "annex_labeller"
  sequence = ref:(AlphaUpperNumericSequence)
  context = ref:(DocumentContext)
  type = "annex"
  template = ref:(AnnexLabelTemplate)
  global_template = ref:(AnnexGlobalLabelTemplate)
  definition = "Labeller for annexes in the document"
}

LabelTemplate "AnnexClauseLabelTemplate" {
  pattern = "%pn.%n"
  definition = "Template for local annex clause references"
}

LabelTemplate "AnnexClauseGlobalLabelTemplate" {
  pattern = "%pn.%n"
  definition = "Template for global annex clause references"
}

Labeller "AnnexClauseLabeller" {
  id = "annex_clause_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(AnnexContext)
  parent = ref:(AnnexLabeller)
  type = "clause"
  template = ref:(AnnexClauseLabelTemplate)
  global_template = ref:(AnnexClauseGlobalLabelTemplate)
  definition = "Labeller for clauses within annexes"
}

LabelTemplate "FigureLabelTemplate" {
  pattern = "Figure %n"
  definition = "Template for local figure references in the main document"
}

LabelTemplate "FigureGlobalLabelTemplate" {
  pattern = "Figure %n"
  definition = "Template for global figure references in the main document"
}

Labeller "FigureLabeller" {
  id = "figure_labeller"
  sequence = ref:(DecimalNumericSequence)
  context = ref:(DocumentContext)
  type = "figure"
  template = ref:(FigureLabelTemplate)
  global_template = ref:(FigureGlobalLabelTemplate)
  definition = "Labeller for figures in the main document"
}

LabelTemplate "AnnexFigureLabelTemplate" {
  pattern = "Figure %pn.%n"
  definition = "Template for local figure references in annexes"
}

LabelTemplate "AnnexFigureGlobalLabelTemplate" {
  pattern = "Figure %pn.%n"
  definition = "Template for global figure references in annexes"
}

Labeller "AnnexFigureLabeller" {
